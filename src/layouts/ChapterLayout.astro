---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import StatusTag from '../components/StatusTag.astro';
import RelatedTopics from '../components/RelatedTopics.astro';
import DecisionList from '../components/DecisionList.astro';
import { levelLabel } from '../lib/content/levels';
import { isAvailable, type ChapterMeta } from '../lib/content/catalog';
import { chapterHref } from '../lib/content/rules';
import type { ChapterData } from '../lib/content/schema';
import type { DecisionRecord } from '../lib/decisions/collection';
import { whyNotHref, type ChapterComparison } from '../lib/why-not/compare';
import type { Comparison } from '../lib/why-not/schema';
import '../styles/prose.css';

interface Props {
  data: ChapterData;
  headings?: MarkdownHeading[];
  previous?: ChapterMeta;
  next?: ChapterMeta;
  connections?: { related: ChapterMeta[]; referencedBy: ChapterMeta[] };
  /** Decision records that link to this chapter. */
  decisions?: DecisionRecord[];
  /** "Why not?" comparisons in which this chapter is one of the solutions. */
  comparisons?: ChapterComparison<Comparison>[];
}

const {
  data,
  headings = [],
  previous,
  next,
  connections = { related: [], referencedBy: [] },
  decisions = [],
  comparisons = [],
} = Astro.props;
const isPlaceholder = data.status === 'placeholder';
const toc = isPlaceholder ? [] : headings.filter((h) => h.depth === 2);
---

<BaseLayout title={data.title} description={data.summary}>
  {
    !isPlaceholder && (
      <>
        <div class="reading-progress" data-slug={data.slug} aria-hidden="true">
          <div class="reading-progress__bar" />
        </div>
        <button class="reading-ring" type="button" aria-label="Back to top" tabindex="-1" data-reading-ring>
          <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false">
            <circle class="reading-ring__track" cx="24" cy="24" r="21" />
            <circle class="reading-ring__fill" cx="24" cy="24" r="21" pathLength="100" />
          </svg>
          <span class="reading-ring__value" aria-hidden="true" data-reading-percent>0%</span>
          <svg class="reading-ring__done" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M5 12.5l4.5 4.5L19 7.5" />
          </svg>
        </button>
        <div class="reading-resume" role="region" aria-label="Continue reading" hidden>
          <button class="reading-resume__go" type="button" data-resume>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M12 5v14M6 13l6 6 6-6" />
            </svg>
            Continue reading
            <span class="reading-resume__percent" data-resume-percent />
          </button>
          <button class="reading-resume__close" type="button" aria-label="Dismiss" data-resume-close>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M6 6l12 12M18 6 6 18" />
            </svg>
          </button>
        </div>
      </>
    )
  }
  <div class="container chapter-page">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/roadmap">Roadmap</a></li>
        <li><a href={`/roadmap#level-${data.level}`}>{levelLabel(data.level)}</a></li>
      </ol>
    </nav>

    <div class:list={['chapter-grid', { 'has-toc': toc.length > 1 }]}>
      <article class="chapter">
        <header class="chapter__header">
          <p class="chapter__meta">
            {data.chapter && <span class="chapter__number">{data.chapter}</span>}
            {data.difficulty && <span class="chapter__difficulty">{data.difficulty}</span>}
            {data.status === 'draft' && <span class="chapter__badge">Draft — not published</span>}
          </p>
          <h1 class="chapter__title">{data.title}</h1>
          {data.summary && <p class="chapter__summary editorial">{data.summary}</p>}
        </header>

        {
          toc.length > 1 && (
            <details class="toc toc--inline">
              <summary>
                On this page<span class="toc__time" data-reading-left />
              </summary>
              <ol>
                {toc.map((h) => (
                  <li>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ol>
            </details>
          )
        }

        {
          isPlaceholder ? (
            <div class="chapter__placeholder" role="status">
              <p class="chapter__placeholder-title">In preparation</p>
              <p>This chapter is being written and reviewed. It will appear here once approved.</p>
              {data.topics.length > 0 && (
                <>
                  <p class="chapter__placeholder-title">Planned topics</p>
                  <ul>
                    {data.topics.map((topic) => (
                      <li>{topic}</li>
                    ))}
                  </ul>
                </>
              )}
            </div>
          ) : (
            <div class="prose">
              <slot />
            </div>
          )
        }

        <RelatedTopics {...connections} />

        {
          decisions.length > 0 && (
            <section class="chapter-decisions" aria-labelledby="chapter-decisions">
              <h2 id="chapter-decisions">Decisions that use this chapter</h2>
              <DecisionList records={decisions} />
            </section>
          )
        }

        {
          comparisons.length > 0 && (
            <section class="chapter-decisions" aria-labelledby="chapter-comparisons">
              <h2 id="chapter-comparisons">Compared with alternatives</h2>
              <ul class="chapter-comparisons">
                {comparisons.map(({ comparison, solution }) => (
                  <li>
                    <a class="chapter-comparison" href={whyNotHref(comparison.id)}>
                      <span class="chapter-comparison__meta">As “{solution}”, for the need</span>
                      <span class="chapter-comparison__row">
                        <span class="chapter-comparison__title">{comparison.need}</span>
                        <StatusTag status={comparison.status} />
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          (previous || next) && (
            <nav class="pager" aria-label="Chapters">
              {previous && (
                <a class="pager__link pager__link--previous" href={chapterHref(previous.slug)} rel="prev">
                  <span class="pager__label">Previous</span>
                  <span class:list={['pager__title', { 'is-muted': !isAvailable(previous) }]}>
                    {previous.chapter && <span class="pager__number">{previous.chapter}</span>}
                    {previous.title}
                  </span>
                  <StatusTag status={previous.status} />
                </a>
              )}
              {next && (
                <a class="pager__link pager__link--next" href={chapterHref(next.slug)} rel="next">
                  <span class="pager__label">Next</span>
                  <span class:list={['pager__title', { 'is-muted': !isAvailable(next) }]}>
                    {next.chapter && <span class="pager__number">{next.chapter}</span>}
                    {next.title}
                  </span>
                  <StatusTag status={next.status} />
                </a>
              )}
            </nav>
          )
        }
      </article>

      {
        toc.length > 1 && (
          <aside class="toc toc--side">
            <nav aria-label="On this page">
              <p class="toc__title">On this page</p>
              <p class="toc__time toc__time--side" data-reading-left />
              <div class="toc__list">
                <span class="toc__rail" aria-hidden="true">
                  <span class="toc__rail-fill" />
                </span>
                <ol>
                  {toc.map((h) => (
                    <li>
                      <a href={`#${h.slug}`}>{h.text}</a>
                    </li>
                  ))}
                </ol>
              </div>
            </nav>
          </aside>
        )
      }
    </div>
  </div>
</BaseLayout>

<script>
  // Loads the diagram renderer (and Mermaid) only when this chapter contains a diagram.
  if (document.querySelector('figure[data-diagram]')) {
    void import('../scripts/diagrams').then(({ renderDiagrams }) => renderDiagrams());
  }
  // Reading progress: the top bar, time left and the current section in the table of contents.
  if (document.querySelector('.reading-progress')) {
    void import('../scripts/reading-progress').then(({ initReadingProgress }) => initReadingProgress());
  }
  // …and the calculator script only when it contains a calculator.
  if (document.querySelector('figure[data-calculator]')) {
    void import('../scripts/calculators').then(({ initCalculators }) => initCalculators());
  }
</script>

<style>
  .chapter-page {
    padding-block: var(--space-4) var(--space-12);
  }

  /* Reading progress: fills across the top as the reader moves through the chapter text. */
  .reading-progress {
    position: fixed;
    top: env(safe-area-inset-top, 0px);
    inset-inline: 0;
    /* Just below the page loader (200), which takes this spot while the next page loads. */
    z-index: 199;
    height: 3px;
    pointer-events: none;
    transition: opacity 200ms ease;
  }

  .reading-progress__bar {
    height: 100%;
    border-radius: 0 2px 2px 0;
    background: var(--color-accent-ink);
    transform: scaleX(0);
    transform-origin: left center;
    will-change: transform;
  }

  :global(.is-navigating) .reading-progress {
    opacity: 0;
  }

  @media print {
    .reading-progress,
    .reading-ring,
    .reading-resume {
      display: none;
    }
  }

  /* Circular progress: bottom right, above the bottom navigation on phones. Shows the
     percentage read (a tick when finished); tapping it returns to the top. */
  .reading-ring {
    position: fixed;
    right: var(--gutter);
    bottom: calc(var(--bottom-nav-height) + env(safe-area-inset-bottom, 0px) + var(--space-3));
    z-index: 150;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--color-surface);
    box-shadow: 0 4px 16px rgb(7 21 30 / 0.14);
    color: var(--color-text);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translateY(0.5rem) scale(0.9);
  }

  .reading-ring.is-shown {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .reading-ring {
      transition:
        opacity 200ms ease,
        transform 200ms cubic-bezier(0.2, 0.8, 0.2, 1),
        visibility 200ms;
    }
  }

  @media (min-width: 64rem) {
    .reading-ring {
      right: var(--space-6);
      bottom: var(--space-6);
    }
  }

  .reading-ring:hover {
    box-shadow:
      0 4px 16px rgb(7 21 30 / 0.14),
      0 0 0 1px var(--color-accent);
  }

  .reading-ring svg:first-child {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }

  .reading-ring circle {
    fill: none;
    stroke-width: 3;
  }

  .reading-ring__track {
    stroke: var(--color-border);
  }

  .reading-ring__fill {
    stroke: var(--color-accent-ink);
    stroke-linecap: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
  }

  .reading-ring__value {
    position: relative;
    font-size: 0.6875rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .reading-ring__done {
    display: none;
    position: relative;
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: var(--color-accent-ink);
    stroke-width: 2.25;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .reading-ring.is-done .reading-ring__value {
    display: none;
  }

  .reading-ring.is-done .reading-ring__done {
    display: block;
  }

  /* "Continue reading": a pill above the bottom navigation (phones) or near the bottom. */
  .reading-resume {
    position: fixed;
    left: 50%;
    bottom: calc(var(--bottom-nav-height) + env(safe-area-inset-bottom, 0px) + var(--space-3));
    z-index: 150;
    display: flex;
    align-items: center;
    max-width: calc(100vw - 2 * var(--gutter));
    padding: var(--space-1);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    box-shadow: 0 6px 24px rgb(7 21 30 / 0.14);
    transform: translateX(-50%);
  }

  .reading-resume[hidden] {
    display: none;
  }

  @media (min-width: 64rem) {
    .reading-resume {
      bottom: var(--space-6);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .reading-resume {
      animation: resume-in 240ms cubic-bezier(0.2, 0.8, 0.2, 1);
    }
  }

  @keyframes resume-in {
    from {
      opacity: 0;
      transform: translate(-50%, 0.5rem);
    }
  }

  .reading-resume button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--color-text);
    font: inherit;
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .reading-resume__go {
    padding-inline: var(--space-3) var(--space-2);
    font-weight: 500;
    white-space: nowrap;
  }

  .reading-resume__go:hover,
  .reading-resume__close:hover {
    background: var(--color-bg);
  }

  .reading-resume__percent {
    color: var(--color-accent-ink);
    font-variant-numeric: tabular-nums;
  }

  .reading-resume__close {
    justify-content: center;
    width: 2.75rem;
    color: var(--color-text-muted) !important;
  }

  .reading-resume svg {
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (min-width: 48rem) {
    .chapter-page {
      padding-block-start: var(--space-6);
    }
  }

  /* Breadcrumb */
  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    margin: 0 0 var(--space-4);
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }

  .breadcrumb li + li::before {
    content: '/';
    margin-right: var(--space-2);
    color: var(--color-text-muted);
  }

  .breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--color-text);
    text-decoration: underline;
  }

  /* Layout */
  .chapter {
    min-width: 0;
  }

  @media (min-width: 68rem) {
    .chapter-grid.has-toc {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 15rem;
      gap: var(--space-16);
    }
  }

  /* Header */
  .chapter__header,
  .chapter__placeholder {
    max-width: var(--measure);
  }

  .chapter__header {
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .chapter__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: 0 0 var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .chapter__meta:empty {
    display: none;
  }

  .chapter__number {
    color: var(--color-accent-ink);
    font-family: var(--font-mono);
  }

  .chapter__difficulty {
    text-transform: capitalize;
  }

  .chapter__badge {
    padding-inline: var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .chapter__title {
    margin: 0;
    font-size: var(--text-3xl);
  }

  .chapter__summary {
    margin: var(--space-3) 0 0;
    font-size: var(--text-xl);
    line-height: 1.45;
    color: var(--color-text-muted);
  }

  /* Placeholder */
  .chapter__placeholder {
    padding: var(--space-6);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .chapter__placeholder p {
    margin: 0;
  }

  .chapter__placeholder-title {
    margin-bottom: var(--space-2) !important;
    font-weight: 600;
  }

  .chapter__placeholder p + .chapter__placeholder-title {
    margin-top: var(--space-6) !important;
  }

  .chapter__placeholder ul {
    margin: 0;
    padding-left: 1.2em;
    color: var(--color-text-muted);
  }

  /* Table of contents */
  .toc ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .toc a {
    display: block;
    padding-block: var(--space-1);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.4;
    text-decoration: none;
  }

  .toc a:hover,
  .toc a[aria-current='true'] {
    color: var(--color-text);
  }

  @media (prefers-reduced-motion: no-preference) {
    .toc a {
      transition: color var(--duration-fast) ease;
    }
  }

  /* Time left, e.g. "On this page · 12 min left". */
  .toc__time {
    color: var(--color-text-muted);
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }

  .toc__time:empty {
    display: none;
  }

  summary .toc__time::before {
    content: ' · ';
  }

  .toc--inline {
    max-width: var(--measure);
    margin-bottom: var(--space-6);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .toc--inline summary {
    line-height: 2rem;
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
  }

  .toc--inline ol {
    margin-top: var(--space-2);
  }

  .toc--inline a[aria-current='true'] {
    font-weight: 500;
  }

  .toc--side {
    display: none;
  }

  @media (min-width: 68rem) {
    .toc--inline {
      display: none;
    }

    .toc--side {
      display: block;
    }

    .toc--side nav {
      position: sticky;
      top: var(--space-8);
      max-height: calc(100vh - var(--space-16));
      overflow-y: auto;
    }
  }

  .toc__title {
    margin: 0 0 var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .toc__time--side {
    margin: calc(var(--space-1) * -1) 0 var(--space-3);
    font-size: 0.75rem;
  }

  /* Side contents: a rail beside the sections fills with the reading progress, and the
     current section is marked on it. */
  .toc__list {
    position: relative;
    padding-left: var(--space-4);
  }

  .toc__rail {
    position: absolute;
    inset-block: 0;
    left: 0;
    width: 1px;
    background: var(--color-border);
  }

  .toc__rail-fill {
    position: absolute;
    inset: 0 -0.5px;
    background: var(--color-accent);
    transform: scaleY(0);
    transform-origin: top center;
    will-change: transform;
  }

  .toc__list a {
    position: relative;
  }

  .toc__list a[aria-current='true']::before {
    content: '';
    position: absolute;
    inset-block: var(--space-1);
    left: calc(var(--space-4) * -1 - 1px);
    width: 3px;
    border-radius: 2px;
    background: var(--color-accent-ink);
  }

  /* Decision records */
  .chapter-decisions {
    max-width: var(--measure);
    margin-top: var(--space-8);
  }

  .chapter-decisions h2 {
    margin: 0 0 var(--space-4);
    font-size: var(--text-xl);
  }

  .chapter-comparisons {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chapter-comparison {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text);
    text-decoration: none;
  }

  .chapter-comparison:hover {
    border-color: var(--color-accent);
  }

  .chapter-comparison__meta {
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }

  .chapter-comparison__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-2);
  }

  .chapter-comparison__title {
    font-weight: 500;
  }

  /* Previous / next */
  .pager {
    display: grid;
    gap: var(--space-3);
    max-width: var(--measure);
    margin-top: var(--space-12);
  }

  @media (min-width: 40rem) {
    .pager {
      grid-template-columns: 1fr 1fr;
    }

    .pager__link--next {
      grid-column: 2;
      text-align: right;
      align-items: flex-end;
    }
  }

  .pager__link {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text);
    text-decoration: none;
  }

  .pager__link:hover {
    border-color: var(--color-accent);
  }

  .pager__label {
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-weight: 500;
  }

  .pager__title {
    font-weight: 500;
  }

  .pager__title.is-muted {
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .pager__number {
    margin-right: var(--space-2);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
</style>
