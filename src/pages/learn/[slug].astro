---
import { render } from 'astro:content';
import ChapterLayout from '../../layouts/ChapterLayout.astro';
import { getCurriculum, getPublishedChapters } from '../../lib/content/chapters';
import { neighbours } from '../../lib/content/catalog';
import { buildConnections } from '../../lib/content/graph';
import { getDecisionCatalog } from '../../lib/decisions/collection';
import { decisionsByChapter } from '../../lib/decisions/records';
import { getComparisons } from '../../lib/why-not/collection';
import { comparisonsByChapter } from '../../lib/why-not/compare';

export async function getStaticPaths() {
  const [chapters, curriculum, { records }, comparisonList] = await Promise.all([
    getPublishedChapters(),
    getCurriculum(),
    getDecisionCatalog(),
    getComparisons(),
  ]);
  const connections = buildConnections(curriculum);
  const decisions = decisionsByChapter(records);
  const comparisons = comparisonsByChapter(comparisonList);
  return chapters.map((chapter) => ({
    params: { slug: chapter.id },
    props: {
      chapter,
      ...neighbours(curriculum, chapter.data.slug),
      connections: connections.get(chapter.data.slug) ?? { related: [], referencedBy: [] },
      decisions: decisions.get(chapter.data.slug) ?? [],
      comparisons: comparisons.get(chapter.data.slug) ?? [],
    },
  }));
}

const { chapter, previous, next, connections, decisions, comparisons } = Astro.props;
const { Content, headings } = await render(chapter);
---

<ChapterLayout
  data={chapter.data}
  headings={headings}
  previous={previous}
  next={next}
  connections={connections}
  decisions={decisions}
  comparisons={comparisons}
>
  {chapter.data.status !== 'placeholder' && <Content />}
</ChapterLayout>
