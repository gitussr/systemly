---
import BaseLayout from '../layouts/BaseLayout.astro';
import AvailabilityFilter from '../components/AvailabilityFilter.astro';
import StatusTag from '../components/StatusTag.astro';
import { getCurriculum } from '../lib/content/chapters';
import { groupByLevel, isAvailable } from '../lib/content/catalog';
import { chapterHref } from '../lib/content/rules';

const levels = groupByLevel(await getCurriculum());
const total = levels.reduce((sum, l) => sum + l.chapters.length, 0);
const available = levels.reduce((sum, l) => sum + l.available, 0);
---

<BaseLayout title="Roadmap" description="The Systemly curriculum, level by level.">
  <div class="container roadmap">
    <header class="page-header">
      <h1>Roadmap</h1>
      <p class="page-header__lede">
        {`${levels.length} levels, from foundations to real-world system design. ${available} of ${total} chapters are available; the rest are in preparation.`}
      </p>
      <div class="roadmap-controls">
        <AvailabilityFilter />
        <button type="button" class="expand-all" aria-pressed="false" hidden>Expand all</button>
      </div>
    </header>

    <nav class="level-jump" aria-label="Levels">
      <ol>
        {
          levels.map((l) => (
            <li>
              <a
                class:list={['level-chip', { 'is-soon': l.available === 0 }]}
                href={`#level-${l.level}`}
                data-level={l.level}
                data-slugs={l.chapters.filter(isAvailable).map((c) => c.slug).join(' ')}
                title={`${l.available} of ${l.chapters.length} chapters available`}
              >
                <span class="level-chip__ring" aria-hidden="true">
                  <svg viewBox="0 0 36 36" focusable="false">
                    <circle class="level-chip__track" cx="18" cy="18" r="16" />
                    <circle class="level-chip__fill" cx="18" cy="18" r="16" pathLength="100" />
                  </svg>
                  <span class="level-chip__number">{l.level}</span>
                </span>
                <span class="level-chip__name">
                  <span class="visually-hidden">{`Level ${l.level}: `}</span>
                  {l.name}
                </span>
                {l.available === 0 && <span class="level-chip__soon">Soon</span>}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    {
      levels.map((l) => (
        <section class="level" id={`level-${l.level}`} aria-labelledby={`level-${l.level}-title`}>
          {/* Levels fold away so the roadmap stays short; Level 0 starts open, and the script opens the reader's current level instead. */}
          <details class="level__details" open={l.level === levels[0].level} data-slugs={l.chapters.filter(isAvailable).map((c) => c.slug).join(' ')}>
            <summary class="level__summary">
              <h2 id={`level-${l.level}-title`}>
                <span class="level__number">Level {l.level}</span>
                {l.name}
              </h2>
              <svg class="level__chevron" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M6 9l6 6 6-6" />
              </svg>
              <span class="level__progress">
                {l.available} of {l.chapters.length} available
              </span>
              <span class="progress" aria-hidden="true">
                <span style={`width: ${l.chapters.length ? (l.available / l.chapters.length) * 100 : 0}%`} />
              </span>
              {l.available > 0 && (
                <span class="reader-progress" data-slugs={l.chapters.filter(isAvailable).map((c) => c.slug).join(' ')} hidden>
                  <span class="reader-progress__cells" aria-hidden="true">
                    {l.chapters.filter(isAvailable).map((c) => (
                      <span class="reader-progress__cell" data-slug={c.slug} title={`${c.chapter} ${c.title}`} />
                    ))}
                  </span>
                  <span class="reader-progress__label" />
                </span>
              )}
            </summary>

            <ol class="chapter-list">
              {l.chapters.map((c) => (
                <li class="chapter-row" data-status={c.status}>
                  <span class="chapter-row__number">{c.chapter}</span>
                  <div class="chapter-row__body">
                    <a
                      class:list={['chapter-row__title', { 'is-muted': !isAvailable(c) }]}
                      href={chapterHref(c.slug)}
                    >
                      {c.title}
                    </a>
                    <StatusTag status={c.status} />
                    {isAvailable(c) && (
                      <span class="row-progress" data-slug={c.slug} hidden>
                        <span class="row-progress__track" aria-hidden="true">
                          <span class="row-progress__fill" />
                        </span>
                        <span class="row-progress__value" />
                      </span>
                    )}
                    {c.topics.length > 0 && <p class="chapter-row__topics">{c.topics.join(' · ')}</p>}
                  </div>
                </li>
              ))}
            </ol>
            {l.available === 0 && (
              <p class="level__empty" data-when-filtered>
                No chapters in this level are available yet.
              </p>
            )}
          </details>
        </section>
      ))
    }
  </div>
</BaseLayout>

<script>
  import { initRoadmapProgress } from '../scripts/roadmap-progress';
  initRoadmapProgress();
</script>

<style>
  .roadmap {
    padding-block: var(--space-8) var(--space-12);
  }

  .page-header {
    max-width: var(--measure);
  }

  .page-header h1 {
    margin: 0;
    font-size: var(--text-3xl);
  }

  .page-header__lede {
    margin: var(--space-3) 0 var(--space-2);
    color: var(--color-text-muted);
  }

  .roadmap-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
  }

  .expand-all {
    min-height: 2.75rem;
    padding: 0 var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-text);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 500;
    cursor: pointer;
  }

  .expand-all:hover {
    border-color: var(--color-accent);
  }

  .expand-all[hidden] {
    display: none;
  }

  .level-jump {
    position: sticky;
    top: 0;
    z-index: 10;
    margin: var(--space-2) calc(var(--gutter) * -1) 0;
    padding: var(--space-2) var(--gutter);
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .level-jump ol {
    /* Contains the visually hidden labels, so they scroll with the list instead of widening the page. */
    position: relative;
    display: flex;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    overflow-x: auto;
    list-style: none;
    scrollbar-width: none;
    /* Fades the last chip at the edge so the strip reads as scrollable. */
    mask-image: linear-gradient(to right, #000 calc(100% - var(--space-8)), transparent);
  }

  .level-jump ol::-webkit-scrollbar {
    display: none;
  }

  .level-jump li:last-child {
    padding-right: var(--space-8);
  }

  /* A level: its number in a ring that fills with the reader's progress, and its name. */
  .level-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding: var(--space-1) var(--space-3) var(--space-1) var(--space-1);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: 500;
    white-space: nowrap;
    text-decoration: none;
  }

  .level-chip:hover {
    border-color: var(--color-accent);
  }

  .level-chip[aria-current='true'] {
    border-color: var(--color-accent-ink);
    box-shadow: inset 0 0 0 1px var(--color-accent-ink);
  }

  .level-chip.is-soon {
    color: var(--color-text-muted);
    font-weight: 400;
  }

  @media (prefers-reduced-motion: no-preference) {
    .level-chip {
      transition: border-color var(--duration-fast) ease, box-shadow var(--duration-fast) ease;
    }
  }

  .level-chip__ring {
    position: relative;
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 2rem;
    height: 2rem;
  }

  .level-chip__ring svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }

  .level-chip__ring circle {
    fill: none;
    stroke-width: 2.5;
  }

  .level-chip__track {
    stroke: var(--color-border);
  }

  .level-chip__fill {
    stroke: var(--color-accent-ink);
    stroke-linecap: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
  }

  .level-chip__number {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
  }

  .level-chip.is-done .level-chip__ring {
    border-radius: 50%;
    background: var(--color-accent-ink);
    color: var(--color-bg);
  }

  .level-chip__soon {
    padding-inline: var(--space-2);
    border-radius: 999px;
    background: var(--color-bg);
    color: var(--color-text-muted);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .level {
    max-width: var(--measure);
    border-bottom: 1px solid var(--color-border);
    scroll-margin-top: 4rem;
  }

  /* The whole level header is the toggle: name, availability and the reader's progress stay visible when folded. */
  .level__summary {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: start;
    column-gap: var(--space-3);
    padding-block: var(--space-5);
    list-style: none;
    cursor: pointer;
  }

  .level__summary::-webkit-details-marker {
    display: none;
  }

  .level__summary > :not(h2, .level__chevron) {
    grid-column: 1 / -1;
  }

  .level__summary:focus-visible {
    outline: 2px solid var(--color-accent-ink);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .level__summary h2 {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin: 0;
    font-size: var(--text-xl);
  }

  .level__summary:hover h2 {
    color: var(--color-accent-ink);
  }

  .level__chevron {
    width: 1.5rem;
    height: 1.5rem;
    margin-top: var(--space-4);
    fill: none;
    stroke: var(--color-text-muted);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .level__details[open] .level__chevron {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .level__chevron {
      transition: transform var(--duration-fast) ease;
    }
  }

  .level__details[open] > :last-child {
    margin-bottom: var(--space-6);
  }

  .level__number {
    color: var(--color-accent-ink);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .level__progress {
    display: block;
    margin: var(--space-2) 0 var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .progress {
    display: block;
    height: 4px;
    border-radius: 2px;
    background: var(--color-border);
    overflow: hidden;
  }

  .progress span {
    display: block;
    height: 100%;
    background: var(--color-accent);
  }

  /* The reader's progress in a level: one cell per available chapter, filled when read. */
  .reader-progress {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin-top: var(--space-3);
  }

  .reader-progress[hidden] {
    display: none;
  }

  .reader-progress__cells {
    display: flex;
    flex-wrap: wrap;
    gap: 3px;
  }

  .reader-progress__cell {
    width: 0.625rem;
    height: 0.625rem;
    border: 1.5px solid var(--color-accent-ink);
    border-radius: 2px;
    opacity: 0.45;
  }

  .reader-progress__cell[data-state='started'] {
    background: linear-gradient(to top, var(--color-accent-ink) var(--cell-fill, 50%), transparent 0);
    opacity: 1;
  }

  .reader-progress__cell[data-state='read'] {
    background: var(--color-accent-ink);
    opacity: 1;
  }

  .reader-progress__label {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }

  .reader-progress__label strong {
    color: var(--color-text);
    font-weight: 500;
  }

  /* A chapter's progress: a slim bar with a dotted remainder, and the percentage. */
  .row-progress {
    display: inline-flex;
    flex-basis: 100%;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-1);
  }

  .row-progress[hidden] {
    display: none;
  }

  .row-progress__track {
    position: relative;
    width: 7.5rem;
    height: 0.375rem;
    border-radius: 999px;
    background: radial-gradient(circle, var(--color-border) 1px, transparent 1.2px) 0 50% / 4px 4px;
    overflow: hidden;
  }

  .row-progress__fill {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--color-accent-ink);
    transform: scaleX(var(--progress, 0));
    transform-origin: left center;
  }

  .row-progress__value {
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .row-progress[data-state='read'] .row-progress__value {
    color: var(--color-accent-ink);
    font-weight: 500;
  }

  .chapter-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chapter-row {
    display: grid;
    grid-template-columns: 3.25rem 1fr;
    gap: var(--space-2);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .chapter-row__number {
    padding-top: 0.15em;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .chapter-row__body {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-2);
  }

  .chapter-row__title {
    color: var(--color-text);
    font-weight: 500;
    text-decoration: none;
  }

  .chapter-row__title:hover {
    color: var(--color-accent-ink);
    text-decoration: underline;
  }

  .chapter-row__title.is-muted {
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .chapter-row__topics {
    flex-basis: 100%;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .level__empty {
    margin: var(--space-4) 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>
