---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { getCurriculum } from '../lib/content/chapters';
import { firstAvailable, groupByLevel } from '../lib/content/catalog';
import { chapterHref } from '../lib/content/rules';
import { site } from '../config/site';
import type { IconName } from '../config/icons';

/*
 * Copy on this page comes from MASTER-PROMPT.md: §1 identity (hero title, tagline, audience,
 * "Systemly is NOT", the central mental model and core principle) and §7 evolution (the
 * V1–V4 architectures). Tool descriptions are each tool page's own description. Level names
 * and chapter titles come from the curriculum. Only the short section headings are UI labels.
 */
const cycle = ['Understand', 'Model', 'Decide', 'Build', 'Measure', 'Scale', 'Recover', 'Evolve'];

const evolution = [
  { version: 'V1', nodes: ['Client', 'Monolith', 'Database'] },
  { version: 'V2', nodes: ['Client', 'Load Balancer', 'Application Instances', 'Database'] },
  { version: 'V3', nodes: ['Client', 'CDN / Load Balancer', 'Application Instances', 'Cache', 'Database'] },
  { version: 'V4', nodes: ['Application', 'Queue', 'Workers', 'Database / Object Storage'] },
];

const notList = [
  'a system-design interview cheat sheet',
  'an AWS product encyclopedia',
  'a collection of buzzwords',
  'a collection of copied blog posts',
  'an AI-generated wall of text',
  'a "microservices are better" tutorial',
  'a collection of architecture diagrams without reasoning',
];

const tools: { href: string; icon: IconName; title: string; text: string }[] = [
  { href: '/advisor', icon: 'compass', title: 'Advisor', text: 'Describe your application and get an explained starting architecture.' },
  { href: '/evolution', icon: 'sprout', title: 'Evolution', text: 'See how an architecture changes as a system grows, and why each change happens.' },
  { href: '/playground', icon: 'shapes', title: 'Playground', text: 'Build an architecture, connect its components, and get warnings that explain common mistakes.' },
  { href: '/decisions', icon: 'notebook-pen', title: 'Decisions', text: 'Architecture Decision Records: the context, options, trade-offs and reversal plan behind each decision.' },
  { href: '/why-not', icon: 'git-compare', title: 'Why not?', text: 'One need, several possible solutions: when each one makes sense, and when it does not.' },
];

const curriculum = await getCurriculum();
const start = firstAvailable(curriculum);
const levels = groupByLevel(curriculum);
const total = levels.reduce((sum, l) => sum + l.chapters.length, 0);
const available = levels.reduce((sum, l) => sum + l.available, 0);
---

<BaseLayout>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero__inner">
      <div class="hero__copy">
        <p class="hero__eyebrow">{site.tagline}</p>
        <h1 id="hero-title" class="hero__title">Systemly — Learn how systems work, grow, and evolve.</h1>
        <p class="hero__lede">
          For developers who want to understand system design from first principles through advanced
          distributed systems. <strong>Systemly teaches developers to reason about systems.</strong>
        </p>
        <div class="hero__actions">
          {
            start && (
              <a class="hero__button hero__button--primary" href={chapterHref(start.slug)}>
                Start with {start.title}
                <span aria-hidden="true">→</span>
              </a>
            )
          }
          <a class="hero__button" href="/roadmap">View the roadmap</a>
        </div>
        <dl class="hero__stats">
          <div>
            <dt>Levels</dt>
            <dd>{levels.length}</dd>
          </div>
          <div>
            <dt>Chapters</dt>
            <dd>{total}</dd>
          </div>
          <div>
            <dt>Ready to read</dt>
            <dd>{available}</dd>
          </div>
        </dl>
      </div>

      <figure class="evo" aria-labelledby="evo-caption" data-evolution>
        <div class="evo__tabs" role="tablist" aria-label="Architecture versions">
          {
            evolution.map((stage, i) => (
              <button
                class="evo__tab"
                type="button"
                role="tab"
                id={`evo-tab-${i}`}
                aria-controls={`evo-panel-${i}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
              >
                {stage.version}
              </button>
            ))
          }
        </div>
        <div class="evo__stage">
          {
            evolution.map((stage, i) => (
              <ol
                class="evo__panel"
                role="tabpanel"
                id={`evo-panel-${i}`}
                aria-labelledby={`evo-tab-${i}`}
                hidden={i !== 0}
              >
                {stage.nodes.map((node) => (
                  <li class="evo__node">{node}</li>
                ))}
              </ol>
            ))
          }
        </div>
        <figcaption id="evo-caption" class="evo__caption">
          <a href="/evolution">See how an architecture changes as a system grows, and why each change happens.</a>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="band container" aria-labelledby="model-title">
    <h2 id="model-title" class="band__title">The central mental model</h2>
    <ol class="cycle">
      {
        cycle.map((step, i) => (
          <li class="cycle__step">
            <span class="cycle__number">{String(i + 1).padStart(2, '0')}</span>
            <span class="cycle__name">{step}</span>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="band container" aria-labelledby="levels-title">
    <div class="band__head">
      <h2 id="levels-title" class="band__title">What you'll learn</h2>
      <p class="band__lede">
        {`${levels.length} levels, from foundations to real-world system design. ${available} of ${total} chapters are available; the rest are in preparation.`}
      </p>
    </div>
    <ol class="levels">
      {
        levels.map((l) => {
          const titles = l.chapters.slice(0, 3).map((c) => c.title);
          const ready = l.available > 0;
          return (
            <li>
              <a class:list={['level-card', { 'is-soon': !ready }]} href={`/roadmap#level-${l.level}`}>
                <span class="level-card__number">{String(l.level).padStart(2, '0')}</span>
                <span class="level-card__name">{l.name}</span>
                {titles.length > 0 && <span class="level-card__topics">{titles.join(' · ')}</span>}
                <span class="level-card__meta">
                  {ready ? (
                    <>
                      <span class="level-card__bar" aria-hidden="true">
                        <span style={`width: ${(l.available / l.chapters.length) * 100}%`} />
                      </span>
                      {l.available} of {l.chapters.length} available
                    </>
                  ) : (
                    <span class="level-card__soon">Soon</span>
                  )}
                </span>
              </a>
            </li>
          );
        })
      }
    </ol>
    <p class="band__more"><a href="/roadmap">Open the full roadmap →</a></p>
  </section>

  <section class="band container" aria-labelledby="tools-title">
    <div class="band__head">
      <h2 id="tools-title" class="band__title">Interactive tools</h2>
    </div>
    <ul class="tools">
      {
        tools.map((tool) => (
          <li>
            <a class="tool" href={tool.href}>
              <span class="tool__icon">
                <Icon name={tool.icon} />
              </span>
              <span class="tool__title">{tool.title}</span>
              <span class="tool__text">{tool.text}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="band container not" aria-labelledby="not-title">
    <h2 id="not-title" class="band__title">Systemly is NOT</h2>
    <ul class="not__list">
      {notList.map((item) => <li>{item}</li>)}
    </ul>
    <p class="not__is editorial">Systemly teaches developers to reason about systems.</p>
  </section>

  <section class="closing" aria-labelledby="principle-title">
    <div class="container closing__inner">
      <h2 id="principle-title" class="visually-hidden">The core principle</h2>
      <blockquote>
        <p class="editorial">
          Start simple. Understand the constraints. Find the bottleneck. Solve that bottleneck. Repeat.
        </p>
      </blockquote>
      {
        start && (
          <a class="hero__button hero__button--primary" href={chapterHref(start.slug)}>
            Start with {start.title}
            <span aria-hidden="true">→</span>
          </a>
        )
      }
    </div>
  </section>
</BaseLayout>

<script>
  // The hero's evolution card: tabs V1–V4. It advances on its own while on screen, until the
  // reader picks a version, hovers or focuses it; never with reduced motion.
  const figure = document.querySelector<HTMLElement>('[data-evolution]');
  if (figure) {
    const tabs = [...figure.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...figure.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    let current = 0;
    let timer = 0;
    let stopped = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const show = (index: number, focus = false) => {
      current = (index + tabs.length) % tabs.length;
      tabs.forEach((tab, i) => {
        const selected = i === current;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
        panels[i].hidden = !selected;
      });
      if (focus) tabs[current].focus();
    };
    const stop = () => {
      stopped = true;
      clearInterval(timer);
    };
    const play = () => {
      clearInterval(timer);
      if (!stopped) timer = window.setInterval(() => show(current + 1), 3200);
    };

    tabs.forEach((tab, i) =>
      tab.addEventListener('click', () => {
        stop();
        show(i);
      }),
    );
    figure.addEventListener('keydown', (event) => {
      const step = { ArrowRight: 1, ArrowLeft: -1 }[event.key];
      if (!step || !(event.target instanceof HTMLElement) || event.target.getAttribute('role') !== 'tab') return;
      event.preventDefault();
      stop();
      show(current + step, true);
    });
    figure.addEventListener('pointerenter', () => clearInterval(timer));
    figure.addEventListener('pointerleave', play);
    figure.addEventListener('focusin', stop);
    new IntersectionObserver(([entry]) => (entry.isIntersecting ? play() : clearInterval(timer))).observe(figure);
  }
</script>

<style>
  /* Hero: Systemly green, with a faint grid of dots. */
  .hero {
    --hero-bg: var(--systemly-green);
    --hero-ink: var(--charcoal);
    --hero-muted: rgb(7 21 30 / 0.72);
    --hero-line: rgb(7 21 30 / 0.16);
    --hero-card: #ffffff;

    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle, rgb(7 21 30 / 0.08) 1px, transparent 1.4px) 0 0 / 22px 22px,
      linear-gradient(160deg, #7ed7a3 0%, var(--hero-bg) 55%, #5fc589 100%);
    color: var(--hero-ink);
  }

  :global(:root[data-theme='dark']) .hero {
    --hero-bg: var(--systemly-green-ink);
    --hero-ink: #f3f7f5;
    --hero-muted: rgb(243 247 245 / 0.78);
    --hero-line: rgb(243 247 245 / 0.18);
    --hero-card: #0d1f2b;

    background:
      radial-gradient(circle, rgb(255 255 255 / 0.07) 1px, transparent 1.4px) 0 0 / 22px 22px,
      linear-gradient(160deg, #1f7a4d 0%, var(--hero-bg) 55%, #145638 100%);
  }

  .hero__inner {
    display: grid;
    gap: var(--space-8);
    padding-block: var(--space-12);
  }

  @media (min-width: 60rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      align-items: center;
      gap: var(--space-12);
      padding-block: var(--space-16);
    }
  }

  .hero__eyebrow {
    display: inline-block;
    margin: 0 0 var(--space-4);
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--hero-line);
    border-radius: 999px;
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .hero__title {
    max-width: 16ch;
    margin: 0;
    color: inherit;
    font-size: clamp(2rem, 1.2rem + 3.6vw, 3.5rem);
    line-height: 1.08;
  }

  .hero__lede {
    max-width: 46ch;
    margin: var(--space-5) 0 0;
    color: var(--hero-muted);
    font-size: var(--text-lg);
    line-height: 1.55;
  }

  .hero__lede strong {
    color: var(--hero-ink);
    font-weight: 500;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .hero__button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 3rem;
    padding: var(--space-2) var(--space-6);
    border: 1px solid var(--hero-ink);
    border-radius: 999px;
    color: var(--hero-ink);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
  }

  .hero__button:hover {
    background: rgb(255 255 255 / 0.16);
  }

  .hero__button--primary {
    background: var(--charcoal);
    border-color: var(--charcoal);
    color: var(--ghost-white);
  }

  .hero__button--primary:hover {
    background: #13262f;
  }

  :global(:root[data-theme='dark']) .hero__button--primary {
    background: var(--systemly-green);
    border-color: var(--systemly-green);
    color: var(--charcoal);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__button span {
      transition: transform var(--duration-fast) ease;
    }

    .hero__button:hover span {
      transform: translateX(3px);
    }
  }

  .hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    margin: var(--space-8) 0 0;
    padding-top: var(--space-6);
    border-top: 1px solid var(--hero-line);
  }

  .hero__stats div {
    display: flex;
    flex-direction: column-reverse;
  }

  .hero__stats dt {
    color: var(--hero-muted);
    font-size: var(--text-sm);
  }

  .hero__stats dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 2rem;
    font-style: italic;
    line-height: 1.1;
  }

  /* Evolution card */
  .evo {
    margin: 0;
    padding: var(--space-4);
    border-radius: 1rem;
    background: var(--hero-card);
    box-shadow: 0 20px 50px rgb(7 21 30 / 0.18);
    color: var(--color-text);
  }

  .evo__tabs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-1);
    padding: var(--space-1);
    border-radius: 999px;
    background: var(--color-bg);
  }

  .evo__tab {
    min-height: 2.5rem;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--color-text-muted);
    font: inherit;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    cursor: pointer;
  }

  .evo__tab[aria-selected='true'] {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .evo__tab {
      transition: background-color 250ms ease, color 250ms ease;
    }
  }

  /* All versions share one cell, so switching never changes the card's height. */
  .evo__stage {
    display: grid;
    padding-block: var(--space-5) var(--space-3);
  }

  .evo__panel {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .evo__panel[hidden] {
    display: flex;
    visibility: hidden;
  }

  .evo__node {
    position: relative;
    min-width: 11rem;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    font-size: var(--text-sm);
    font-weight: 500;
    text-align: center;
  }

  .evo__node + .evo__node {
    margin-top: var(--space-6);
  }

  /* The arrow down to each component. */
  .evo__node + .evo__node::before {
    content: '';
    position: absolute;
    bottom: calc(100% + 1px);
    left: 50%;
    width: 2px;
    height: calc(var(--space-6) - 2px);
    background: var(--color-accent-ink);
    transform: translateX(-50%);
  }

  .evo__node + .evo__node::after {
    content: '';
    position: absolute;
    bottom: 100%;
    left: 50%;
    border: 5px solid transparent;
    border-top-color: var(--color-accent-ink);
    border-bottom: 0;
    transform: translateX(-50%);
  }

  @media (prefers-reduced-motion: no-preference) {
    .evo__panel:not([hidden]) .evo__node {
      animation: node-in 420ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }

    .evo__panel:not([hidden]) .evo__node:nth-child(2) {
      animation-delay: 70ms;
    }

    .evo__panel:not([hidden]) .evo__node:nth-child(3) {
      animation-delay: 140ms;
    }

    .evo__panel:not([hidden]) .evo__node:nth-child(4) {
      animation-delay: 210ms;
    }

    .evo__panel:not([hidden]) .evo__node:nth-child(5) {
      animation-delay: 280ms;
    }
  }

  @keyframes node-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  .evo__caption {
    padding: var(--space-3) var(--space-2) 0;
    border-top: 1px solid var(--color-border);
    font-size: var(--text-sm);
    text-align: center;
  }

  .evo__caption a {
    color: var(--color-accent-ink);
    text-decoration: none;
  }

  .evo__caption a:hover {
    text-decoration: underline;
  }

  /* Sections */
  .band {
    padding-block: var(--space-12) 0;
  }

  @media (min-width: 48rem) {
    .band {
      padding-block-start: var(--space-16);
    }
  }

  .band__head {
    max-width: var(--measure);
  }

  .band__title {
    margin: 0 0 var(--space-6);
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-style: italic;
    font-weight: 500;
  }

  .band__head .band__title {
    margin-bottom: var(--space-2);
  }

  .band__lede {
    margin: 0 0 var(--space-6);
    color: var(--color-text-muted);
  }

  .band__more {
    margin: var(--space-6) 0 0;
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .band__more a {
    color: var(--color-accent-ink);
    text-decoration: none;
  }

  .band__more a:hover {
    text-decoration: underline;
  }

  /* The mental model: eight numbered steps on a line. */
  .cycle {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .cycle {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .cycle {
      grid-template-columns: repeat(8, minmax(0, 1fr));
      gap: 0;
    }
  }

  .cycle__step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  @media (min-width: 64rem) {
    .cycle__step {
      border-radius: 0;
      border-left-width: 0;
    }

    .cycle__step:first-child {
      border-left-width: 1px;
      border-radius: var(--radius-md) 0 0 var(--radius-md);
    }

    .cycle__step:last-child {
      border-radius: 0 var(--radius-md) var(--radius-md) 0;
    }

    .cycle__step:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 50%;
      right: -6px;
      z-index: 1;
      width: 10px;
      height: 10px;
      border-top: 1px solid var(--color-border);
      border-right: 1px solid var(--color-border);
      background: var(--color-surface);
      transform: translateY(-50%) rotate(45deg);
    }
  }

  .cycle__number {
    color: var(--color-accent-ink);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .cycle__name {
    font-weight: 500;
  }

  /* Levels */
  .levels {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .levels {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .levels {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .level-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
  }

  .level-card:hover {
    border-color: var(--color-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .level-card {
      transition: border-color var(--duration-fast) ease, transform var(--duration-fast) ease;
    }

    .level-card:hover {
      transform: translateY(-2px);
    }
  }

  .level-card__number {
    color: var(--color-accent-ink);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .level-card__name {
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .level-card__topics {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .level-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: auto;
    padding-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }

  .level-card__bar {
    flex: none;
    width: 3.5rem;
    height: 4px;
    border-radius: 2px;
    background: var(--color-border);
    overflow: hidden;
  }

  .level-card__bar span {
    display: block;
    height: 100%;
    background: var(--color-accent);
  }

  .level-card.is-soon .level-card__name {
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .level-card__soon {
    padding-inline: var(--space-2);
    border-radius: 999px;
    background: var(--color-bg);
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  /* Tools */
  .tools {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .tools {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
