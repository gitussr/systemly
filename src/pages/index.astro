---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCurriculum } from '../lib/content/chapters';
import { firstAvailable } from '../lib/content/catalog';
import { chapterHref } from '../lib/content/rules';

// Copy on this page is taken verbatim from MASTER-PROMPT.md (§1 identity, §1 core philosophy).
const cycle = ['Understand', 'Model', 'Decide', 'Build', 'Measure', 'Scale', 'Recover', 'Evolve'];

const start = firstAvailable(await getCurriculum());
---

<BaseLayout>
  <section class="hero container" aria-labelledby="hero-title">
    <p class="hero__eyebrow">Think about systems systematically.</p>
    <h1 id="hero-title" class="hero__title">
      Systemly — Learn how systems work, grow, and evolve.
    </h1>
    <div class="hero__actions">
      {
        start && (
          <a class="button button--primary" href={chapterHref(start.slug)}>
            Start with {start.title}
          </a>
        )
      }
      <a class="button" href="/roadmap">View the roadmap</a>
    </div>
  </section>

  <section class="container model" aria-labelledby="model-title">
    <h2 id="model-title" class="visually-hidden">The central mental model</h2>
    <ol class="cycle">
      {cycle.map((step) => <li>{step}</li>)}
    </ol>
  </section>

  <section class="container principle" aria-labelledby="principle-title">
    <h2 id="principle-title" class="visually-hidden">The core principle</h2>
    <blockquote>
      <p class="editorial">
        Start simple. Understand the constraints. Find the bottleneck. Solve that bottleneck.
        Repeat.
      </p>
    </blockquote>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-12) var(--space-8);
  }

  .hero__eyebrow {
    margin: 0 0 var(--space-4);
    color: var(--color-accent-ink);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .hero__title {
    max-width: 20ch;
    margin: 0;
    font-size: var(--text-3xl);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .cycle {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .cycle li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .cycle li:not(:last-child)::after {
    content: '→';
    color: var(--color-accent-ink);
  }

  .principle blockquote {
    max-width: var(--measure);
    margin: var(--space-12) 0 0;
    padding-left: var(--space-6);
    border-left: 3px solid var(--color-accent);
  }

  .principle p {
    margin: 0;
    font-size: var(--text-xl);
    line-height: 1.4;
  }
</style>
