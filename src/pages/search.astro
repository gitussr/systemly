---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Search" description="Search every Systemly chapter.">
  <div class="container search-page">
    <h1>Search</h1>

    <form class="search-form" role="search" action="/search" method="get">
      <label class="visually-hidden" for="search-input">Search chapters</label>
      <svg class="search-form__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.5-3.5"></path>
      </svg>
      <input
        id="search-input"
        class="search-form__input"
        type="search"
        name="q"
        placeholder="Search chapters, e.g. load balancer"
        autocomplete="off"
        spellcheck="false"
        enterkeyhint="search"
        aria-describedby="search-status"
        aria-controls="search-results"
      />
    </form>

    <p id="search-status" class="search-status" role="status" aria-live="polite"></p>
    <div id="search-results" class="search-results"></div>

    <noscript>
      <p class="search-status">
        Search needs JavaScript. Browse the <a href="/roadmap">roadmap</a> or the
        <a href="/learn">library</a> instead.
      </p>
    </noscript>
  </div>
</BaseLayout>

<script>
  import { initSearch } from '../scripts/search';
  initSearch();
</script>

<style>
  .search-page {
    padding-block: var(--space-8) var(--space-12);
  }

  h1 {
    margin: 0 0 var(--space-6);
    font-size: var(--text-3xl);
  }

  .search-form {
    position: relative;
    max-width: var(--measure);
  }

  .search-form__icon {
    position: absolute;
    top: 50%;
    left: var(--space-4);
    width: 1.25rem;
    height: 1.25rem;
    transform: translateY(-50%);
    fill: none;
    stroke: var(--color-text-muted);
    stroke-width: 2;
    stroke-linecap: round;
    pointer-events: none;
  }

  .search-form__input {
    width: 100%;
    min-height: 3.25rem;
    padding: var(--space-3) var(--space-4) var(--space-3) 3rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text);
    font: inherit;
    font-size: var(--text-lg);
  }

  .search-form__input::placeholder {
    color: var(--color-text-muted);
  }

  .search-form__input:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 1px;
  }

  .search-status {
    max-width: var(--measure);
    min-height: 1.5em;
    margin: var(--space-4) 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  /* Result markup is created by the script, so these styles are global to this page. */
  .search-results :global(h2) {
    margin: var(--space-8) 0 var(--space-3);
    font-size: var(--text-lg);
  }

  .search-results :global(ol) {
    display: grid;
    gap: var(--space-2);
    max-width: var(--measure);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .search-results :global(.result) {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text);
    text-decoration: none;
  }

  .search-results :global(.result:hover),
  .search-results :global(.result:focus-visible) {
    border-color: var(--color-accent);
  }

  .search-results :global(.result__meta) {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-2);
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }

  .search-results :global(.result__number) {
    font-family: var(--font-mono);
  }

  .search-results :global(.result__title) {
    font-weight: 500;
  }

  .search-results :global(.result__title.is-muted) {
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .search-results :global(.result__tag) {
    margin-left: var(--space-2);
    padding: 0 var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .search-results :global(.result__summary) {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>
