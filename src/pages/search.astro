---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBox from '../components/SearchBox.astro';
---

<BaseLayout title="Search" description="Search every Systemly chapter and decision record.">
  <div class="container search-page">
    <h1>Search</h1>
    <SearchBox id="search" />

    <noscript>
      <p class="search-page__noscript">
        Search needs JavaScript. Browse the <a href="/roadmap">roadmap</a> or the
        <a href="/learn">library</a> instead.
      </p>
    </noscript>
  </div>
</BaseLayout>

<script>
  import { initSearch } from '../scripts/search';
  import { shortPlaceholder } from '../scripts/search-dialog';

  // This page (opened directly, from a ?q= link, or without the dialog) keeps the query in the URL.
  const input = document.querySelector<HTMLInputElement>('#search-input');
  const status = document.querySelector<HTMLElement>('#search-status');
  const results = document.querySelector<HTMLElement>('#search-results');
  if (input && status && results) {
    const run = initSearch({ input, status, results, syncUrl: true });
    shortPlaceholder(input);
    const initial = new URLSearchParams(location.search).get('q') ?? '';
    if (initial) {
      input.value = initial;
      void run(initial);
    }
    input.focus();
  }
</script>

<style>
  .search-page {
    padding-block: var(--space-8) var(--space-12);
  }

  h1 {
    margin: 0 0 var(--space-6);
    font-size: var(--text-3xl);
  }

  .search-page__noscript {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>
