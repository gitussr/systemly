---
/**
 * Phones and tablets: a floating "liquid glass" navigation bar, after iOS 26's material.
 * The two sections (Roadmap and System Lab) on the left, the current one marked by a drop of
 * green glass that morphs to the other tab on navigation (a cross-document view transition);
 * a glass search button on the right opens the search dialog (src/scripts/search-dialog.ts;
 * without JavaScript it links to /search).
 *
 * The glass: the backdrop is brightened and saturated, a rim catches light from above (or
 * from the phone's tilt), and in Chromium the edges refract the content behind like a lens:
 * src/scripts/liquid-glass.ts draws each shape's displacement map
 * for the filters below. The bar shrinks to its icons while the reader scrolls down.
 */
import Icon from './Icon.astro';
import { inSection, site } from '../config/site';

const current = Astro.url.pathname;

// One lens filter per glass shape; liquid-glass.ts sets each one's map, region and scale.
const lenses = ['lens-bar', 'lens-search'];
---

<nav class="bottom-nav" aria-label="Main">
  <div class="bottom-nav__bar" data-lens="lens-bar">
    <ul class="bottom-nav__items">
      {
        site.nav.map((item) => {
          const here = inSection(current, item);
          return (
            <li>
              <a class="bottom-nav__item" href={item.href} aria-current={here ? 'page' : undefined}>
                {here && <span class="bottom-nav__drop" aria-hidden="true" />}
                <Icon name={item.icon} />
                <span class="bottom-nav__label">{item.label}</span>
              </a>
            </li>
          );
        })
      }
    </ul>
    <a
      class="bottom-nav__search"
      href="/search"
      aria-label="Search"
      aria-haspopup="dialog"
      data-search-open
      data-lens="lens-search"
    >
      <Icon name="search" />
    </a>
  </div>
</nav>

<svg class="bottom-nav__filters" aria-hidden="true" focusable="false" width="0" height="0">
  {
    lenses.map((id) => (
      <filter id={id} filterUnits="userSpaceOnUse" primitiveUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
        <feImage preserveAspectRatio="none" result="map" />
        <feDisplacementMap in="SourceGraphic" in2="map" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    ))
  }
</svg>

<script>
  import { initLiquidGlass } from '../scripts/liquid-glass';
  initLiquidGlass();
</script>

<style>
  /* Shown below 64rem; wide screens use the header links instead. */
  .bottom-nav {
    --spring: cubic-bezier(0.34, 1.45, 0.64, 1);
    --light-angle: 170deg;
    position: fixed;
    inset: auto var(--space-3) calc(var(--space-3) + env(safe-area-inset-bottom));
    z-index: 20;
    display: flex;
    justify-content: center;
    pointer-events: none; /* only the glass takes taps */
    interpolate-size: allow-keywords; /* lets the bar's width spring to and from its compact size */
  }

  @media (min-width: 64rem) {
    .bottom-nav {
      display: none;
    }
  }

  .bottom-nav__filters {
    position: absolute;
    width: 0;
    height: 0;
  }

  /*
   * The glass. Clear in the middle, the backdrop brightened and saturated; a rim lit from
   * --light-angle (::before); a sheen pooled on the upper half (::after); a soft lift.
   */
  .bottom-nav__bar,
  .bottom-nav__search {
    --glass: color-mix(in srgb, var(--color-surface) 22%, transparent);
    --rim-lit: rgb(255 255 255 / 0.95);
    --rim-dim: rgb(255 255 255 / 0.12);
    --sheen: rgb(255 255 255 / 0.3);
    position: relative;
    isolation: isolate;
    border-radius: 999px;
    -webkit-backdrop-filter: blur(3px) saturate(1.8) brightness(1.08);
    backdrop-filter: blur(3px) saturate(1.8) brightness(1.08);
    pointer-events: auto;
  }

  /* Chromium refracts the backdrop through the lens map, once one has been drawn (.has-lens). */
  @supports (backdrop-filter: url(#a)) and (interpolate-size: allow-keywords) {
    .bottom-nav__bar:global(.has-lens) {
      backdrop-filter: url(#lens-bar) blur(1px) saturate(1.8) brightness(1.08);
    }

    .bottom-nav__search:global(.has-lens) {
      backdrop-filter: url(#lens-search) saturate(1.6) brightness(1.05);
    }
  }

  .bottom-nav__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    width: 100%;
    max-width: 26rem;
    height: var(--bottom-nav-bar);
    padding: 0 var(--space-1) 0 var(--space-1);
    background: var(--glass);
    box-shadow:
      0 14px 34px rgb(7 21 30 / 0.16),
      0 3px 8px rgb(7 21 30 / 0.08),
      inset 0 0 18px rgb(255 255 255 / 0.22);
    transition:
      width 0.5s var(--spring),
      transform 0.45s var(--spring);
  }

  /* Pressing anywhere on the bar: it swells a little and springs back, like a drop of liquid. */
  .bottom-nav__bar:active {
    transform: scale(1.025);
  }

  .bottom-nav__bar::before,
  .bottom-nav__bar::after,
  .bottom-nav__search::before,
  .bottom-nav__search::after {
    content: '';
    position: absolute;
    border-radius: inherit;
    pointer-events: none;
  }

  /* The rim: a thin ring, brightest where the light falls, nearly gone opposite it. */
  .bottom-nav__bar::before,
  .bottom-nav__search::before {
    inset: 0;
    z-index: 2;
    padding: 1.25px;
    background: linear-gradient(
      var(--light-angle),
      var(--rim-lit),
      var(--rim-dim) 38%,
      var(--rim-dim) 66%,
      rgb(255 255 255 / 0.5)
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box exclude,
      linear-gradient(#000 0 0);
    transition: background 0.3s linear;
  }

  /* The sheen: light pooled under the top edge, fading towards the middle. */
  .bottom-nav__bar::after,
  .bottom-nav__search::after {
    inset: 1px 8% 52%;
    z-index: -1;
    background: linear-gradient(180deg, var(--sheen), transparent);
    filter: blur(1.5px);
  }

  /* Browsers without backdrop effects get a nearly opaque surface, so text behind stays out of the way. */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .bottom-nav__bar,
    .bottom-nav__search {
      --glass: color-mix(in srgb, var(--color-surface) 96%, transparent);
    }
  }

  :global(:root[data-theme='dark']) .bottom-nav__bar,
  :global(:root[data-theme='dark']) .bottom-nav__search {
    --glass: color-mix(in srgb, var(--color-surface) 38%, transparent);
    --rim-lit: rgb(255 255 255 / 0.4);
    --rim-dim: rgb(255 255 255 / 0.05);
    --sheen: rgb(255 255 255 / 0.07);
  }

  :global(:root[data-theme='dark']) .bottom-nav__bar {
    box-shadow:
      0 14px 34px rgb(0 0 0 / 0.5),
      inset 0 0 18px rgb(255 255 255 / 0.04);
  }

  .bottom-nav__items {
    display: flex;
    gap: 0.125rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .bottom-nav__item {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.875rem;
    padding: 0 var(--space-4);
    border-radius: 999px;
    color: var(--color-text-muted);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition:
      padding 0.5s var(--spring),
      gap 0.5s var(--spring);
  }

  .bottom-nav__item :global(.icon) {
    width: 1.375rem;
    height: 1.375rem;
    flex: none;
    stroke-width: 1.5;
  }

  .bottom-nav__label {
    max-width: 7rem;
    overflow: hidden;
    font-size: var(--text-sm);
    font-weight: 500;
    white-space: nowrap;
    transition:
      max-width 0.5s var(--spring),
      opacity 0.25s ease;
  }

  .bottom-nav__item:hover,
  .bottom-nav__item[aria-current='page'] {
    color: var(--color-text);
  }

  .bottom-nav__item[aria-current='page'] .bottom-nav__label {
    font-weight: 700;
  }

  /* The current section: a drop of green glass under the tab, lit from above. */
  .bottom-nav__drop {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background:
      radial-gradient(80% 60% at 50% 0%, rgb(255 255 255 / 0.55), transparent 70%),
      color-mix(in srgb, var(--color-accent) 34%, transparent);
    box-shadow:
      inset 0 1px 1px rgb(255 255 255 / 0.85),
      inset 0 -1px 3px color-mix(in srgb, var(--color-accent-ink) 30%, transparent),
      0 2px 8px color-mix(in srgb, var(--color-accent-ink) 18%, transparent);
    transition: transform 0.4s var(--spring);
    view-transition-name: nav-drop;
  }

  :global(:root[data-theme='dark']) .bottom-nav__drop {
    background:
      radial-gradient(80% 60% at 50% 0%, rgb(255 255 255 / 0.18), transparent 70%),
      color-mix(in srgb, var(--color-accent) 26%, transparent);
    box-shadow:
      inset 0 1px 1px rgb(255 255 255 / 0.3),
      0 2px 8px rgb(0 0 0 / 0.3);
  }

  .bottom-nav__item:active .bottom-nav__drop {
    transform: scale(1.1, 1.06);
  }

  /* Scrolling down: the bar draws in to its icons; scrolling up brings the labels back. */
  .bottom-nav:global(.is-compact) .bottom-nav__bar {
    width: fit-content;
  }

  .bottom-nav:global(.is-compact) .bottom-nav__label {
    max-width: 0;
    opacity: 0;
  }

  .bottom-nav:global(.is-compact) .bottom-nav__item {
    gap: 0;
    padding-inline: var(--space-3);
  }

  /* The search button: a drop of green-tinted glass beside the tabs, with a dark green symbol (white in dark theme). */
  .bottom-nav__search {
    --glass: color-mix(in srgb, var(--color-accent) 55%, transparent);
    --sheen: rgb(255 255 255 / 0.55);
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 2.875rem;
    background:
      radial-gradient(90% 70% at 50% 0%, rgb(255 255 255 / 0.45), transparent 65%),
      var(--glass);
    color: var(--color-accent-ink);
    box-shadow:
      0 8px 18px rgb(63 174 118 / 0.38),
      inset 0 -3px 8px rgb(27 110 69 / 0.3);
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.45s var(--spring);
  }

  :global(:root[data-theme='dark']) .bottom-nav__search {
    --glass: color-mix(in srgb, var(--color-accent) 42%, transparent);
    color: #ffffff;
  }

  .bottom-nav__search :global(.icon) {
    position: relative;
    z-index: 1;
    width: 1.375rem;
    height: 1.375rem;
    stroke-width: 2.25;
  }

  .bottom-nav__search:active {
    transform: scale(0.92);
  }

  .bottom-nav__item:focus-visible,
  .bottom-nav__search:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .bottom-nav__bar,
    .bottom-nav__item,
    .bottom-nav__label,
    .bottom-nav__drop,
    .bottom-nav__search {
      transition: none;
    }

    .bottom-nav__bar:active,
    .bottom-nav__search:active,
    .bottom-nav__item:active .bottom-nav__drop {
      transform: none;
    }
  }
</style>
