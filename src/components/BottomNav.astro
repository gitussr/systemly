---
/**
 * Phones and tablets: a floating navigation bar near the bottom of the screen, in subtle
 * frosted glass (blur, a light tint, faint grain and a thin rim). Three equal tabs, each a thin
 * icon above a small label: Roadmap, System Lab and Search. Search opens the search dialog
 * (src/scripts/search-dialog.ts); without JavaScript it is a link to /search.
 */
import Icon from './Icon.astro';
import { inSection, isCurrent, site } from '../config/site';
import type { NavItem } from '../config/site';

const current = Astro.url.pathname;
const search: NavItem = { label: 'Search', href: '/search', icon: 'search' };
const tabs = [...site.nav, search];
---

<nav class="bottom-nav" aria-label="Main">
  <ul class="bottom-nav__bar">
    {
      tabs.map((item) => {
        const isSearch = item === search;
        const here = isSearch ? isCurrent(current, item.href) : inSection(current, item);
        return (
          <li>
            <a
              class="bottom-nav__item"
              href={item.href}
              aria-current={here ? 'page' : undefined}
              aria-haspopup={isSearch ? 'dialog' : undefined}
              data-search-open={isSearch ? '' : undefined}
            >
              <span class="bottom-nav__icon">
                <Icon name={item.icon} />
              </span>
              <span class="bottom-nav__label">{item.label}</span>
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>

<style>
  /* Shown below 64rem; wide screens use the header links instead. */
  .bottom-nav {
    position: fixed;
    inset: auto var(--space-3) calc(var(--space-3) + env(safe-area-inset-bottom));
    z-index: 20;
  }

  @media (min-width: 64rem) {
    .bottom-nav {
      display: none;
    }
  }

  /* Subtle frosted glass: the page behind is blurred under a light tint with a faint grain. */
  .bottom-nav__bar {
    --glass: color-mix(in srgb, var(--color-surface) 72%, transparent);
    --grain: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20width%3D%22140%22%20height%3D%22140%22%3E%3Cfilter%20id%3D%22n%22%3E%3CfeTurbulence%20type%3D%22fractalNoise%22%20baseFrequency%3D%220.85%22%20numOctaves%3D%222%22%20stitchTiles%3D%22stitch%22/%3E%3CfeColorMatrix%20values%3D%220%200%200%200%200.5%20%200%200%200%200%200.5%20%200%200%200%200%200.5%20%200%200%200%200.16%200%22/%3E%3C/filter%3E%3Crect%20width%3D%22140%22%20height%3D%22140%22%20filter%3D%22url%28%23n%29%22/%3E%3C/svg%3E");
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: 24rem;
    height: var(--bottom-nav-bar);
    margin: 0 auto;
    padding: 0 var(--space-1);
    border: 1px solid color-mix(in srgb, var(--color-border) 70%, rgb(255 255 255 / 0.6));
    border-radius: 10px;
    background: var(--grain), var(--glass);
    box-shadow: 0 8px 24px rgb(7 21 30 / 0.1);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    backdrop-filter: blur(16px) saturate(1.4);
    list-style: none;
  }

  /* Browsers without backdrop blur get a nearly opaque surface instead. */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .bottom-nav__bar {
      --glass: color-mix(in srgb, var(--color-surface) 97%, transparent);
    }
  }

  :global(:root[data-theme='dark']) .bottom-nav__bar {
    --glass: color-mix(in srgb, var(--color-surface) 75%, transparent);
    border-color: rgb(255 255 255 / 0.08);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.4);
  }

  .bottom-nav__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.125rem;
    height: 100%;
    color: var(--color-text-muted);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  /* The pill behind the icon marks the current tab. */
  .bottom-nav__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 1.75rem;
    border-radius: 999px;
  }

  /* Thin, crisp line icons: the 1px hairline stroke from Icon.astro. */
  .bottom-nav__icon :global(.icon) {
    width: 1.375rem;
    height: 1.375rem;
  }

  .bottom-nav__label {
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1rem;
    letter-spacing: 0.01em;
  }

  .bottom-nav__item:hover {
    color: var(--color-text);
  }

  .bottom-nav__item[aria-current='page'] {
    color: var(--color-text);
  }

  .bottom-nav__item[aria-current='page'] .bottom-nav__icon {
    background: color-mix(in srgb, var(--color-accent) 30%, transparent);
  }

  .bottom-nav__item[aria-current='page'] .bottom-nav__label {
    font-weight: 700;
  }

  .bottom-nav__item:focus-visible {
    outline: none;
  }

  .bottom-nav__item:focus-visible .bottom-nav__icon {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
</style>
