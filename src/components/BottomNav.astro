---
/**
 * Phones and tablets: a fixed bottom navigation bar in the style of Android's Material 3
 * navigation bar, with the two sections (Roadmap and System Lab). Search and the theme
 * switch are in the header.
 */
import Icon from './Icon.astro';
import { inSection, site } from '../config/site';

const current = Astro.url.pathname;
---

<nav class="bottom-nav" aria-label="Main">
  <ul class="bottom-nav__bar">
    {
      site.nav.map((item) => (
        <li>
          <a
            class="bottom-nav__item"
            href={item.href}
            aria-current={inSection(current, item) ? 'page' : undefined}
          >
            <span class="bottom-nav__indicator">
              <Icon name={item.icon} />
            </span>
            <span class="bottom-nav__label">{item.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  /* Shown below 64rem; wide screens use the header links instead. */
  .bottom-nav {
    position: fixed;
    inset: auto 0 0;
    z-index: 20;
    padding-bottom: env(safe-area-inset-bottom);
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  @media (min-width: 64rem) {
    .bottom-nav {
      display: none;
    }
  }

  .bottom-nav__bar {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-width: 24rem;
    height: var(--bottom-nav-height);
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  .bottom-nav__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    width: 100%;
    height: 100%;
    padding: 0;
    color: var(--color-text-muted);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  /* The pill behind the icon: the Material 3 active indicator. */
  .bottom-nav__indicator {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 2rem;
    border-radius: 999px;
    transition: background-color 150ms ease;
  }

  .bottom-nav__indicator :global(.icon) {
    width: 1.5rem;
    height: 1.5rem;
  }

  .bottom-nav__label {
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1rem;
    letter-spacing: 0.01em;
  }

  .bottom-nav__item:hover .bottom-nav__indicator {
    background: color-mix(in srgb, var(--color-text) 8%, transparent);
  }

  .bottom-nav__item[aria-current='page'] {
    color: var(--color-text);
  }

  .bottom-nav__item[aria-current='page'] .bottom-nav__label {
    font-weight: 700;
  }

  .bottom-nav__item[aria-current='page'] .bottom-nav__indicator {
    background: color-mix(in srgb, var(--color-accent) 35%, transparent);
  }

  .bottom-nav__item:focus-visible {
    outline: none;
  }

  .bottom-nav__item:focus-visible .bottom-nav__indicator {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
</style>
