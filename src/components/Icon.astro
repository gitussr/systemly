---
import { ICONS, type IconName } from '../config/icons';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  class:list={['icon', className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={ICONS[name]}
/>

<style>
  /* Hairline icons: a 1px stroke on screen, whatever size the icon is drawn at. */
  .icon :global(*) {
    vector-effect: non-scaling-stroke;
  }
</style>
