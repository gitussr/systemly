---
import { site } from '../config/site';

const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href="/" aria-label={`${site.name} home`}>
      <!-- Vector wordmark; switches its letter colour for dark mode inside the SVG. -->
      <img src="/logo.svg" width="116" height="31" alt="" />
    </a>
    {
      site.nav.length > 0 && (
        <nav aria-label="Main">
          <ul class="site-header__nav">
            {site.nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={current.startsWith(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    min-height: 3.5rem;
    padding-block: var(--space-3);
  }

  .site-header__brand {
    display: inline-flex;
    padding-block: var(--space-1);
  }

  .site-header__brand img {
    display: block;
    width: 7.25rem;
    height: auto;
  }

  .site-header__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header__nav a {
    display: inline-block;
    padding-block: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
  }

  .site-header__nav a:hover,
  .site-header__nav a[aria-current='page'] {
    color: var(--color-text);
  }

  .site-header__nav a[aria-current='page'] {
    box-shadow: inset 0 -2px 0 var(--color-accent);
  }
</style>
